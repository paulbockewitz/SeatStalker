# Copy this file to .env and fill in your values

# ── Airline CLI paths ────────────────────────────────────────────────────────
# Only needed if the CLI binary is not on your system PATH.

# Path to the delta-trip CLI binary (Delta)
# DELTA_TRIP_CLI=C:\path\to\delta-trip-pp-cli.exe

# Path to the iberia-trips CLI binary (Iberia)
# IBERIA_TRIP_CLI=C:\path\to\iberia-trips-pp-cli.exe

# Set HEADED=true only if Delta blocks headless Chrome (rare fallback — opens a visible browser window)
# HEADED=true

# ── Gmail ───────────────────────────────────────────────────────────────────
# Google Account -> Security -> App Passwords
GMAIL_SENDER=you@gmail.com
GMAIL_RECIPIENT=you@gmail.com   # optional — defaults to GMAIL_SENDER if omitted
GMAIL_APP_PASSWORD=your-app-password-here

# ── Trip to monitor ──────────────────────────────────────────────────────────
# Airline is auto-detected from the flight number prefix (DL=Delta, IB=Iberia).
# Set AIRLINE explicitly if auto-detection doesn't work for your flight number.
# AIRLINE=DL

CONFIRMATION=ABC123
FIRST_NAME=Jane       # required for Delta; ignored by Iberia
LAST_NAME=Smith
FLIGHT=DL1234
TARGET_SEATS=12A,12B
