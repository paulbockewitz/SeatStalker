# Copy this file to .env and fill in your values

# Path to the delta-trip CLI binary (only needed if not on your system PATH)
# DELTA_TRIP_CLI=C:\path\to\delta-trip-pp-cli.exe

# Set HEADED=true only if Delta blocks headless Chrome (rare fallback — opens a visible browser window)
# HEADED=true

# Gmail SMTP — sender address and app password (Google Account -> Security -> App Passwords)
GMAIL_SENDER=you@gmail.com
GMAIL_RECIPIENT=you@gmail.com   # optional — defaults to GMAIL_SENDER if omitted
GMAIL_APP_PASSWORD=your-app-password-here

# Trip to monitor (can be overridden by passing CLI flags)
CONFIRMATION=ABC123
FIRST_NAME=Jane
LAST_NAME=Smith
FLIGHT=DL1234
TARGET_SEATS=12A,12B
